<%- include('../partials/staff-header') %>

<h2 class="mb-4"><i class="bi bi-pencil-square"></i> 领用录入</h2>

<div class="row">
  <div class="col-12 col-lg-8">
    <div class="card">
      <div class="card-header"><i class="bi bi-plus-circle"></i> 新增领用记录</div>
      <div class="card-body">
        <% if (materials.length === 0) { %>
          <div class="alert alert-warning">暂无可领用的宣传品。</div>
        <% } else { %>
          <form method="POST" action="/staff/usage">
            <div class="mb-3">
              <label class="form-label">选择宣传品 <span class="text-danger">*</span></label>
              <select name="material_id" id="materialSelect" class="form-select" required>
                <option value="">-- 请选择 --</option>
                <% materials.forEach(function(m) { %>
                  <option value="<%= m.material_id %>" data-remaining="<%= m.remaining %>" data-unit="<%= m.unit %>">
                    【<%= m.activity_name %>】<%= m.material_name %>（可用 <%= m.remaining %> <%= m.unit %>）
                  </option>
                <% }); %>
              </select>
            </div>
            <div id="stockInfo" class="alert alert-info mb-3" style="display:none;">当前可用库存：<strong id="stockRemaining">0</strong> <span id="stockUnit"></span></div>
            <div class="mb-3">
              <label class="form-label">领用数量 <span class="text-danger">*</span></label>
              <input type="number" name="quantity" id="quantityInput" class="form-control" min="1" required>
              <div id="quantityError" class="invalid-feedback d-none"></div>
            </div>
            <div class="mb-3">
              <label class="form-label">领用客户名称 <span class="text-danger">*</span></label>
              <input type="text" name="customer_name" class="form-control" required>
            </div>
            <div class="mb-4">
              <label class="form-label">备注</label>
              <textarea name="remark" id="remarkInput" class="form-control" rows="3"></textarea>
              <div id="remarkError" class="invalid-feedback d-none">输入信息涉敏，请勿输入</div>
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> 提交领用</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
// 敏感信息识别规则
function containsSensitive(text) {
  if (!text) return false;
  // 18位身份证号码（末位可为X）
  if (/\d{17}[\dXx]/.test(text)) return true;
  // 提取所有连续数字串
  var digitSeqs = text.match(/\d+/g) || [];
  for (var i = 0; i < digitSeqs.length; i++) {
    var len = digitSeqs[i].length;
    if (len === 19) return true;                   // 19位银行卡号/账号
    if (len === 12) return true;                   // 12位电话号码
    if (len === 11 && digitSeqs[i][0] === '1') return true; // 11位手机号
    if (len === 8) return true;                    // 8位电话号码
  }
  return false;
}

document.addEventListener('DOMContentLoaded', function() {
  const select = document.getElementById('materialSelect');
  if (!select) return;
  const stockInfo = document.getElementById('stockInfo');
  const stockRemaining = document.getElementById('stockRemaining');
  const stockUnit = document.getElementById('stockUnit');
  const quantityInput = document.getElementById('quantityInput');
  const quantityError = document.getElementById('quantityError');
  const remarkInput = document.getElementById('remarkInput');
  const remarkError = document.getElementById('remarkError');
  const form = document.querySelector('form[method="POST"]');

  select.addEventListener('change', function() {
    const selected = this.options[this.selectedIndex];
    stockRemaining.textContent = selected.dataset.remaining || 0;
    stockUnit.textContent = selected.dataset.unit || '';
    quantityInput.max = selected.dataset.remaining || 0;
    stockInfo.style.display = this.value ? 'block' : 'none';
    // 切换宣传品时清除错误提示
    quantityInput.classList.remove('is-invalid');
    quantityError.classList.add('d-none');
  });

  // 输入时实时清除错误样式
  quantityInput.addEventListener('input', function() {
    if (quantityInput.classList.contains('is-invalid')) {
      quantityInput.classList.remove('is-invalid');
      quantityError.classList.add('d-none');
    }
  });

  // 备注输入框实时检测敏感信息
  if (remarkInput) {
    remarkInput.addEventListener('input', function() {
      if (containsSensitive(this.value)) {
        remarkInput.classList.add('is-invalid');
        remarkError.classList.remove('d-none');
      } else {
        remarkInput.classList.remove('is-invalid');
        remarkError.classList.add('d-none');
      }
    });
  }

  // 表单提交前校验
  form.addEventListener('submit', function(e) {
    const qty = parseInt(quantityInput.value, 10);
    var remaining = parseInt(stockRemaining.textContent, 10) || 0;

    // 校验1：必须选择宣传品
    if (!select.value) {
      e.preventDefault();
      return;
    }

    // 校验2：数值必须大于0（包括空值、非数字、负数、零）
    if (isNaN(qty) || qty <= 0) {
      e.preventDefault();
      quantityInput.classList.add('is-invalid');
      quantityError.textContent = '领用数量必须大于0';
      quantityError.classList.remove('d-none');
      return;
    }

    // 校验3：不能超过当前可用库存
    if (qty > remaining) {
      e.preventDefault();
      quantityInput.classList.add('is-invalid');
      quantityError.textContent = '领用数量需小于或等于当前可用库存';
      quantityError.classList.remove('d-none');
      return;
    }

    // 校验4：备注不得包含敏感信息
    if (remarkInput && containsSensitive(remarkInput.value)) {
      e.preventDefault();
      remarkInput.classList.add('is-invalid');
      remarkError.classList.remove('d-none');
      remarkInput.focus();
      return;
    }

    // 通过校验，清除错误状态
    quantityInput.classList.remove('is-invalid');
    quantityError.classList.add('d-none');
  });
});
</script>

<%- include('../partials/footer') %>
