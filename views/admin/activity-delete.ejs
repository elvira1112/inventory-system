<%- include('../partials/admin-header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2><i class="bi bi-trash"></i> 活动删除</h2>
  <a href="/admin/activities" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> 返回活动管理</a>
</div>

<% if (activities.length === 0) { %>
  <div class="alert alert-info"><i class="bi bi-info-circle"></i> 当前没有可删除的活动。</div>
<% } else { %>
  <div class="card">
    <div class="card-header"><i class="bi bi-trash"></i> 删除活动</div>
    <div class="card-body">
      <form method="POST" action="/admin/activities/delete" onsubmit="return confirm('确认删除该活动吗？删除后二级人员将看不到该活动，且不可撤销。');">
        <div class="mb-4">
          <label class="form-label"><span class="text-danger">*</span> 需删除的活动</label>
          <select class="form-select" name="activity_id" required>
            <option value="">-- 请选择活动 --</option>
            <% activities.forEach(function(activity) { %>
              <option value="<%= activity.id %>"><%= activity.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="mb-4">
          <label class="form-label"><span class="text-danger">*</span> 删除原因</label>
          <textarea name="delete_reason" class="form-control" rows="3" required placeholder="请输入删除原因"></textarea>
        </div>
        <button type="submit" class="btn btn-danger"><i class="bi bi-check-circle"></i> 提交删除</button>
      </form>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
